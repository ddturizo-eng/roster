{
  "allowManagedPermissionRulesOnly": true,
  "allowManagedHooksOnly": true,
  "disableClaudeAiConnectors": true,
  "permissions": {
    "defaultMode": "dontAsk",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash",
      "Edit",
      "Glob",
      "Grep",
      "Read",
      "Write"
    ],
    "deny": [
      "CronCreate",
      "CronDelete",
      "CronList",
      "EnterWorktree",
      "ExitWorktree",
      "ListAgents",
      "Monitor",
      "NotebookEdit",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "SendMessage",
      "Skill",
      "Task",
      "TaskStop",
      "ToolSearch",
      "WebFetch",
      "WebSearch",
      "Workflow",
      "Bash(git push *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(pnpm add *)",
      "Bash(yarn add *)"
    ]
  }
}
